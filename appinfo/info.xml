<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <!--
        A ordem dos elementos é significativa: o info.xsd define um xs:sequence,
        por isso trocar elementos de sítio faz falhar a validação no upload para
        a App Store. Ordem: id, name, summary, description, version, licence,
        author, namespace, types, documentation, category, website, discussion,
        bugs, repository, screenshot, donation, dependencies, ..., commands,
        settings, activity, dashboard, ...
    -->
    <id>folder_protection</id>
    <name>Folder Protection</name>
    <summary>Protect folders from being moved, copied, or deleted</summary>
    <description>Prevents specific folders from being moved, copied, or deleted to avoid server performance issues with large folders.</description>
    <version>2.4.0</version>
    <licence>agpl</licence>
    <author mail="rsfneg@gmail.com">Ricardo Ferreira</author>
    <namespace>FolderProtection</namespace>

    <types>
        <filesystem/>
    </types>

    <category>files</category>

    <website>https://github.com/kreotropic/folder_protection</website>
    <bugs>https://github.com/kreotropic/folder_protection/issues</bugs>
    <repository>https://github.com/kreotropic/folder_protection</repository>

    <screenshot>https://raw.githubusercontent.com/kreotropic/folder_protection/main/screenshots/Admin_Interface.png</screenshot>
    <screenshot>https://raw.githubusercontent.com/kreotropic/folder_protection/main/screenshots/Add_Protection_Interface.png</screenshot>
    <screenshot>https://raw.githubusercontent.com/kreotropic/folder_protection/main/screenshots/Folder_Picker.png</screenshot>
    <screenshot>https://raw.githubusercontent.com/kreotropic/folder_protection/main/screenshots/Protected_Folder.png</screenshot>
    <screenshot>https://raw.githubusercontent.com/kreotropic/folder_protection/main/screenshots/Widget.png</screenshot>

    <dependencies>
        <php min-version="8.3"/>
        <nextcloud min-version="33" max-version="34"/>
    </dependencies>

    <commands>
        <command>OCA\FolderProtection\Command\ListProtected</command>
        <command>OCA\FolderProtection\Command\Protect</command>
        <command>OCA\FolderProtection\Command\Unprotect</command>
        <command>OCA\FolderProtection\Command\CheckProtection</command>
        <command>OCA\FolderProtection\Command\ClearNotifications</command>
    </commands>

    <settings>
        <admin>OCA\FolderProtection\Settings\AdminSettings</admin>
        <admin-section>OCA\FolderProtection\Settings\AdminSection</admin-section>
    </settings>

    <dashboard>
        <widget>OCA\FolderProtection\Dashboard\ProtectedFoldersWidget</widget>
    </dashboard>

    <!--
        Os blocos <dav><properties> e <notifications><notifier> foram removidos:
        nenhum dos dois existe neste schema nem é lido pelo servidor. As propriedades
        DAV são registadas por DAV\ProtectionPropertyPlugin e o notifier por
        AppInfo\Application::register() via registerNotifierService().
    -->
</info>
